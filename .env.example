# Copy to .env. Docker Compose reads it; bare uvicorn uses the process environment.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8000
DATA_DIR=data
# Bare Python defaults to SQLite. Docker Compose injects PostgreSQL.
# DATABASE_URL=postgresql+psycopg://codecampus:YOUR_PRIVATE_PASSWORD@localhost:5432/codecampus
POSTGRES_PASSWORD=change-this-locally-before-running
STORAGE_BACKEND=local
MAX_UPLOAD_MB=100
AWS_REGION=sa-east-1
S3_BUCKET=
CLAMAV_HOST=
# In production set CLAMAV_HOST=clamav and run docker compose --profile scanning up.
# Prefer AWS SSO locally and IAM task roles in production. No AWS keys in Git.
# AWS_PROFILE=your-sso-profile
